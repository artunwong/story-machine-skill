# story-machine LLM 端点配置（任选其一生效）
# 1) 宿主 session 注入进程环境变量 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL（推荐）
# 2) 复制本文件为 config/.env 并填写

# 占位符说明：
#   LLM_BASE_URL  你的 LLM 端点地址，需兼容 OpenAI /chat/completions 协议
#                 （自建反代、官方 API、或任何 OpenAI 兼容网关均可）
#   LLM_API_KEY   该端点的访问密钥
#   LLM_MODEL     该端点上可用的模型名
LLM_BASE_URL=<YOUR_LLM_BASE_URL>     # 例: https://api.example.com/v1
LLM_API_KEY=<YOUR_LLM_API_KEY>
LLM_MODEL=<YOUR_MODEL_NAME>
